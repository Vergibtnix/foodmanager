FOODMANAGER_DB_NAME=foodmanager
FOODMANAGER_DB_USER=foodmanager
FOODMANAGER_DB_PASSWORD=foodmanager
FOODMANAGER_DB_PORT=5432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

KEYCLOAK_CLIENT_ID=foodmanager-web
KEYCLOAK_CLIENT_SECRET=foodmanager-web-secret

KEYCLOAK_PORT=8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/foodmanager

TS_HOST=localhost

# Tägliche Ablauf-Benachrichtigung per ntfy (App "ntfy" aufs Handy, dasselbe Topic abonnieren).
# Leer lassen = aus. Das Topic lang und zufällig wählen, jeder mit dem Namen kann mitlesen.
FOODMANAGER_NTFY_TOPIC=
# FOODMANAGER_NTFY_SERVER=https://ntfy.sh
# FOODMANAGER_NTFY_TOKEN=

# Wie viele Tage Backups in ./backups aufgehoben werden
BACKUP_KEEP_DAYS=14